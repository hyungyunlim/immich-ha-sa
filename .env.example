PORT=8082
DATA_DIR=./data

# Controller -> services, private/internal addresses.
IMMICH_INTERNAL_URL=http://127.0.0.1:2283
IMMICH_API_KEY=replace-me
KIOSK_INTERNAL_URL=http://127.0.0.1:3000
KIOSK_PASSWORD=

# Browser-facing local URLs for frames on the LAN.
LOCAL_PUBLIC_CONTROLLER_URL=http://192.168.1.251:8082
LOCAL_PUBLIC_KIOSK_URL=http://192.168.1.251:3000

# Browser-facing external URLs for remote frames through Cloudflare Tunnel.
EXTERNAL_PUBLIC_CONTROLLER_URL=https://frame.example.com
EXTERNAL_PUBLIC_KIOSK_URL=https://frame.example.com/kiosk

DEFAULT_FRAME_ID=lenovo
DEFAULT_FRAME_NAME=Lenovo Smart Frame
DEFAULT_NETWORK_MODE=auto
POLL_INTERVAL_SECONDS=20

# Optional bearer token for mutating controller APIs.
CONTROLLER_API_TOKEN=

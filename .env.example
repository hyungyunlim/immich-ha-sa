# Internal app port. Docker users usually do not need to change this.
PORT=8080

# Docker host port exposed on the RPi or server. Change this if 8082 is already in use.
CONTROLLER_HOST_PORT=8082
DATA_DIR=./data

# Controller -> services, private/internal addresses.
IMMICH_INTERNAL_URL=http://127.0.0.1:2283
IMMICH_API_KEY=replace-me
KIOSK_INTERNAL_URL=http://127.0.0.1:3000
KIOSK_PASSWORD=

# Browser-facing local URLs for frames on the LAN. The controller URL port must
# match CONTROLLER_HOST_PORT when running with docker-compose.example.yml.
LOCAL_PUBLIC_CONTROLLER_URL=http://<rpi-lan-ip>:<controller-host-port>
LOCAL_PUBLIC_KIOSK_URL=http://<rpi-lan-ip>:3000

# Browser-facing external URLs for remote frames through Cloudflare Tunnel.
EXTERNAL_PUBLIC_CONTROLLER_URL=https://frame.example.com
EXTERNAL_PUBLIC_KIOSK_URL=https://frame.example.com/kiosk

DEFAULT_FRAME_ID=lenovo
DEFAULT_FRAME_NAME=Lenovo Smart Frame
DEFAULT_NETWORK_MODE=auto
POLL_INTERVAL_SECONDS=20

# Optional static bearer token fallback for mutating controller APIs. Most users
# should leave this blank and use the Home Assistant pairing flow instead.
CONTROLLER_API_TOKEN=
